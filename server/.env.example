# ============ SERVER CONFIG ============
NODE_ENV=development
PORT=5000

# ============ DATABASE ============
# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/foodhub

# ============ JWT ============
JWT_ACCESS_SECRET=replace_with_long_random_string_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============ COOKIES ============
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ============ CLIENT URL (CORS) ============
# Local dev:
CLIENT_URL=http://localhost:5173
# Production (Render backend + Vercel frontend) — comma-separated allow-list:
# CLIENT_URL=https://foodhub-seven-gules.vercel.app,http://localhost:5173
# NOTE: cross-site cookies auto-upgrade to SameSite=None;Secure when the
# frontend host differs from API_URL, so no COOKIE_* change is needed.

# ============ API URL (builds OAuth callback URLs) ============
API_URL=http://localhost:5000

# ============ OAUTH (Google / Facebook) ============
# Google: https://console.cloud.google.com/apis/credentials
# Add callback: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
# Add callback: {API_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============ EMAIL (Nodemailer) ============
# Using ethereal / smtp. For dev, leave as is to skip real sending.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FoodHub <no-reply@foodhub.local>

# ============ PAYMENTS (Razorpay) ============
# Get keys from https://dashboard.razorpay.com/app/keys
# Enable UPI (Google Pay / PhonePe / Paytm) in the Razorpay Dashboard → Settings → Payments → UPI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe (optional, not wired to checkout by default)
STRIPE_SECRET_KEY=
# Currency
CURRENCY=INR
CURRENCY_SYMBOL=₹

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
