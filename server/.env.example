# ============ SERVER CONFIG ============
NODE_ENV=development
PORT=5000

# ============ DATABASE ============
# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/foodhub

# ============ JWT ============
JWT_ACCESS_SECRET=replace_with_long_random_string_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============ COOKIES ============
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ============ CLIENT URL (CORS) ============
# Local dev:
CLIENT_URL=http://localhost:5173
# Production (frontend + API both on Vercel) — comma-separated allow-list:
# CLIENT_URL=https://foodhub-seven-gules.vercel.app,http://localhost:5173
# NOTE: only the FIRST entry is used for redirects/links (OAuth return,
# verify-email, reset-password). The full list is used for CORS.
# NOTE: cross-site cookies auto-upgrade to SameSite=None;Secure when the
# frontend host differs from API_URL, so no COOKIE_* change is needed.

# ============ API URL (builds OAuth callback URLs) ============
API_URL=http://localhost:5000
# Production (Vercel): API_URL=https://foodhub-pearl-tau.vercel.app
# This MUST be the real, live API origin. If it points at a stale/dead host,
# Google rejects sign-in with `Error 400: redirect_uri_mismatch`.

# ============ OAUTH (Google / Facebook) ============
# Google: https://console.cloud.google.com/apis/credentials
# Add this EXACT string under "Authorized redirect URIs":
#   https://foodhub-pearl-tau.vercel.app/api/auth/google/callback
# Optional explicit override (wins over the value derived from API_URL).
# The effective URL is echoed by GET /api/auth/providers as `callbackUrl`.
GOOGLE_CALLBACK_URL=https://foodhub-pearl-tau.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
# Add callback: {API_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============ EMAIL (Nodemailer) ============
# Using ethereal / smtp. For dev, leave as is to skip real sending.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FoodHub <no-reply@foodhub.local>

# ============ PAYMENTS (Razorpay — TEST MODE ONLY) ============
# This project runs Razorpay in TEST MODE ONLY. Real/live keys are REFUSED by
# the server so a production key can never charge a real card by accident.
#
# Get TEST keys from https://dashboard.razorpay.com/app/keys
#   -> make sure the dashboard is in TEST MODE (toggle top-right, orange banner)
#   -> the key id MUST start with rzp_test_
#
# A live key (rzp_live_...) will be detected, logged as BLOCKED, and online
# payments will silently stay off. This is intentional.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# Stripe (optional, not wired to checkout by default)
STRIPE_SECRET_KEY=
# Currency
CURRENCY=INR
CURRENCY_SYMBOL=₹

# ============ ADMIN ============
# Enables POST /api/admin/users/purge (bulk-delete every account except the
# emails passed in "keep"). Intended for resetting a DEMO deployment.
# Leave unset/false on any real deployment — the route then returns 403.
ADMIN_PURGE_ENABLED=false

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
